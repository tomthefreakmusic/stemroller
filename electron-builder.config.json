{
  "directories": {
    "buildResources": "electron-build-resources"
  },
  "appId": "com.tomthefreakmusic.stemroller-roformer",
  "productName": "StemRoller RoFormer",
  "files": [
    {
      "from": "build",
      "to": "renderer-build"
    },
    "main-src",
    "package.json"
  ],
  "extraFiles": [
    {
      "from": "anyos-extra-files/Models",
      "to": "Models"
    },
    {
      "from": "docs",
      "to": "Documentation"
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "public.app-category.music",
    "extraFiles": [
      {
        "from": "mac-extra-files/ThirdPartyApps",
        "to": "ThirdPartyApps"
      }
    ]
  },
  "win": {
    "target": "dir",
    "extraFiles": [
      {
        "from": "win-extra-files/ThirdPartyApps",
        "to": "ThirdPartyApps",
        "filter": [
          "**/*",
          "!bs-roformer/*.dll",
          "!bs-roformer/*.exe"
        ]
      }
    ]
  }
}
